{
  "name": "@qoniai/qoni",
  "version": "0.4.0",
  "description": "Unified Node.js SDK for Qoni Agent delegation, GUMem memory, and WebAgent automation.",
  "homepage": "https://github.com/QONIAI/qoni-sdk-node#readme",
  "bugs": {
    "url": "https://github.com/QONIAI/qoni-sdk-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QONIAI/qoni-sdk-node.git"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "qoni",
    "agent",
    "sdk",
    "delegation",
    "gumem",
    "webagent"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "check:brand": "node scripts/check-brand.mjs",
    "gen:event-types": "node scripts/gen-event-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && pnpm check:brand && pnpm test:mock && pnpm test:package",
    "test:mock": "vitest run --coverage=false tests/qoni.test.ts tests/semantic-surface.test.ts tests/open-source-readiness.test.ts tests/complete-coverage.test.ts tests/event-catalog.test.ts tests/interactions.test.ts tests/contract-surface.test.ts tests/sse-abort.test.ts",
    "test:e2e": "QONI_LIVE_E2E=1 vitest run --coverage=false --fileParallelism=false --maxWorkers=1 --testTimeout=120000 tests/live-e2e/*.test.ts",
    "test:package": "vitest run --coverage=false tests/package-surface.test.ts",
    "test:ci": "pnpm test:mock && pnpm test:package",
    "smoke:auth-gum": "pnpm build && node scripts/qoni-auth-gum-smoke.mjs --mock",
    "smoke:auth-gum:live": "pnpm build && QONI_SMOKE_MODE=live node scripts/qoni-auth-gum-smoke.mjs --live",
    "pack:dry-run": "pnpm build && pnpm pack --dry-run",
    "prepack": "pnpm build",
    "prepare": "tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "author": ""
}
